{:config-paths
 ["../bases/arg-gen/resources/clj-kondo.exports/criterium/arg-gen/"
  "../bases/criterium/resources/clj-kondo.exports/criterium/criterium/"]
 :hooks
 {:analyze-call
  {criterium.view/def-multi-view       hooks.impl/def-multi-view
   criterium.util.forms/cond*          hooks.impl/cond*
   criterium.utils.forms/cond*         hooks.impl/cond*
   criterium.utils.interface/cond*     hooks.impl/cond*}}
 :lint-as {babashka.fs/with-temp-dir                 clojure.core/with-open
           build-test/with-cached-agent-build      clj-kondo.lint-as/def-catch-all
           clojure.test.check.clojure-test/defspec clojure.core/def
           clojure.test.check.properties/for-all   clojure.core/let
           criterium.util/optional-require         clojure.core/require
           criterium.viewer.kindly-clay-test/with-temp-dir clj-kondo.lint-as/def-catch-all}
 :linters {:unused-binding               {:exclude-defmulti-args true}
           :used-underscored-binding     {:level :warning}
           :unsorted-required-namespaces {:level :warning}
           :redundant-primitive-coercion {:level :warning}}
 :output  {:exclude-files ["src/data_readers.clj"]}}
