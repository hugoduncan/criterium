{
  "permissions": {
    "allow": [
      "Bash(./build/test/criterium_tests:*)"
    ]
  },
  "enabledMcpjsonServers": [
    "clojure-mcp",
    "mcp-tasks",
    "clj-kondo"
  ],
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "npx block-no-verify@1.1.2"
          }
        ]
      }
    ]
  }
}
